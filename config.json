{
  "_comment": "サンプル設定。mode=mock は実際のMoneytree・Chatwork・LINE WORKSに一切つながない。",
  "notify_service": "chatwork",
  "_notify_service": "通知先。chatwork か lineworks。python main.py --service lineworks demo で一時的に切り替えて試せる",
  "moneytree": {
    "mode": "mock",
    "mock_file": "data/moneytree_mock.json",
    "csv_file": "data/moneytree_export.csv",
    "csv_columns": {
      "date": "日付",
      "amount": "金額",
      "description": "内容"
    }
  },
  "chatwork": {
    "mode": "mock",
    "mock_file": "data/mock_chatwork.json",
    "token_env": "CHATWORK_API_TOKEN",
    "bot_account_id": "999999",
    "room_id": "400000001"
  },
  "lineworks": {
    "mode": "mock",
    "mock_file": "data/mock_lineworks.json",
    "_comment": "本番は Developer Console のアプリ・Bot・サービスアカウントの値。秘密の値は環境変数に入れ、ここには書かない",
    "bot_id": "",
    "channel_id": "lw-channel-demo",
    "client_id": "",
    "service_account": "",
    "client_secret_env": "LINEWORKS_CLIENT_SECRET",
    "private_key_env": "LINEWORKS_PRIVATE_KEY",
    "inbox_url": "",
    "inbox_token_env": "LINEWORKS_INBOX_TOKEN"
  },
  "expected_file": "data/expected.csv",
  "rules": {
    "ask_days_before": 3,
    "remind_after_hours": 24,
    "max_reminders": 2,
    "cc_manager_from_reminder": 2,
    "overdue_grace_days": 1,
    "match_window_days_before": 7,
    "match_window_days_after": 14,
    "send_hours": [
      9,
      19
    ],
    "fiscal_year_start_month": 4,
    "paid_notice_within_days": 3,
    "match_surname_with_amount": true
  },
  "manager": {
    "name": "経理責任者",
    "account_id": "111111",
    "lineworks_user_id": "manager@example.com"
  },
  "assignees": [
    {
      "name": "佐藤",
      "account_id": "222222",
      "lineworks_user_id": "sato@example.com"
    },
    {
      "name": "鈴木",
      "account_id": "333333",
      "lineworks_user_id": "suzuki@example.com"
    }
  ]
}
